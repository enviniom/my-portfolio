---
import About from "../../components/sections/About.astro";
import Education from "../../components/sections/Education.astro";
import Experience from "../../components/sections/Experience.astro";
import Hero from "../../components/sections/Hero.astro";
import InterestsHobbies from "../../components/sections/InterestsHobbies.astro";
import Languages from "../../components/sections/Languages.astro";
import Certifications from "../../components/sections/Certifications.astro";
import Layout from "../../layouts/Layout.astro";
import Projects from "../../components/sections/Projects.astro";
import Skills from "../../components/sections/Skills.astro";
import TopBar from "../../components/sections/TopBar.astro";

import { getPortfolioData } from "@/content";
import { validateAllResumeProfiles } from "../../lib/resume/selectors";

// Compile-time validations
validateAllResumeProfiles();

const data = getPortfolioData("es");
const {
  basics,
  experiences,
  projects,
  skills,
  education,
  certifications,
  languages,
  interests,
  labels,
} = data;

const pageTitle = `${basics.name} — ${basics.label}`;
---

<Layout
  title={pageTitle}
  summary={basics.summary}
  image={basics.image}
  lang="es"
  canonicalUrl="https://enviniom.github.io/my-portfolio/es/"
>
  <main>
    <TopBar lang="es" />
    <Hero basics={basics} />
    <About
      title={labels.about}
      summary={basics.summary}
      highlights={basics.summaryHighlights}
    />
    <Skills skills={skills} />
    <Experience experiences={experiences} labels={labels} lang="es" />
    <Projects projects={projects} title={labels.projects} labels={labels} />
    <Education education={education} />
    <Certifications certifications={certifications} labels={labels} />
    <Languages languages={languages} />
    <InterestsHobbies interests={interests} />
  </main>
</Layout>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
    max-width: 820px;
  }

  @media (width <= 768px) {
    main {
      padding: 1.5rem 1rem;
    }
  }

  @media print {
    main {
      padding: 0 !important;
      margin: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
    }
  }
</style>

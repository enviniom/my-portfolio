---
import Section from "../Section.astro";
import type { PortfolioData } from "@/content";

interface Props {
  interests: PortfolioData["interests"];
}

const { interests } = Astro.props;
---

<div class="no-print">
  <Section title={interests.title}>
    <ul>
      {
        interests.items.map(({ name }) => (
          <li>
            <span>{name}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</div>

<style>
  ul {
    display: inline-flex;
    gap: 10px;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    border-radius: 4px;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    color: #111827;
    font-size: 0.84rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    box-shadow: 1.5px 1.5px 0px rgba(17, 24, 39, 0.2);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  li:hover {
    border-color: #111827;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #111827;
  }
</style>

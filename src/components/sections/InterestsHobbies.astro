---
import Section from "../Section.astro";
import type { PortfolioData } from "@/content";

interface Props {
  interests: PortfolioData["interests"];
}

const { interests } = Astro.props;
---

<div class="no-print">
  <Section title={interests.title}>
    <ul>
      {
        interests.items.map(({ name }) => (
          <li>
            <span>{name}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</div>

<style>
  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    border-radius: 6px;
    background-color: #eee;
    color: black;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }
</style>

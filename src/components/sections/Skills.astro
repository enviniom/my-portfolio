---
import Section from "../Section.astro";
import type { PortfolioData } from "@/content";

interface Props {
  skills: PortfolioData["skills"];
}

const { skills } = Astro.props;
---

<Section title={skills.title}>
  <div class="skills-categories">
    {
      skills.categories.map(({ title, items }) => (
        <div class="category">
          <h3>{title}</h3>
          <ul>
            {items.map(({ name, level }) => (
              <li>
                <span>{name}</span>
                <small>{level}</small>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .skills-categories {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .category h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
    margin: 0 0 0.5rem 0;
  }

  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    border-radius: 6px;
    background-color: #f3f4f6;
    color: #111827;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.25rem 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid #e5e7eb;
    transition: background 0.15s ease;
  }

  li:hover {
    background-color: #e5e7eb;
  }

  small {
    color: #6b7280;
    font-size: 0.72rem;
    font-weight: 600;
  }

  @media print {
    .skills-categories {
      gap: 0.6rem;
    }
    .category h3 {
      font-size: 0.85rem;
      margin-bottom: 0.25rem;
    }
    ul {
      gap: 5px;
    }
    li {
      background-color: #f9fafb;
      border: 1px solid #d1d5db;
      font-size: 0.72rem;
      padding: 0.1rem 0.4rem;
      color: #111;
    }
    small {
      color: #555;
      font-size: 0.65rem;
    }
  }
</style>

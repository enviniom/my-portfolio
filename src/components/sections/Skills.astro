---
import Section from "../Section.astro";
import type { PortfolioData } from "@/content";

interface Props {
  skills: PortfolioData["skills"];
}

const { skills } = Astro.props;
---

<Section title={skills.title}>
  <div class="skills-categories">
    {
      skills.categories.map(({ title, items }) => (
        <div class="category">
          <h3>{title}</h3>
          <ul>
            {items.map(({ name }) => (
              <li>
                <span>{name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .skills-categories {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .category h3 {
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #111827;
    margin: 0 0 0.45rem 0;
  }

  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    border-radius: 4px;
    background-color: #ffffff;
    color: #111827;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid #d1d5db;
    box-shadow: 1.5px 1.5px 0px rgba(17, 24, 39, 0.15);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  li:hover {
    background-color: #111827;
    color: #ffffff;
    border-color: #111827;
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0px #111827;
  }

  @media print {
    .skills-categories {
      gap: 0.6rem;
    }
    .category h3 {
      font-size: 0.85rem;
      margin-bottom: 0.25rem;
    }
    ul {
      gap: 5px;
    }
    li {
      background-color: #f9fafb;
      border: 1px solid #d1d5db;
      font-size: 0.72rem;
      padding: 0.15rem 0.45rem;
      color: #111;
      box-shadow: none;
    }
  }
</style>

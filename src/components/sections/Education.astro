---
import Section from "../Section.astro";
import type { PortfolioData } from "@/content";

interface Props {
  education: PortfolioData["education"];
}

const { education } = Astro.props;
---

<Section title={education.title}>
  <ul class="education-list">
    {
      education.items.map(({ institution, area, studyType, startDate, endDate, score }) => {
        const start = startDate.substring(0, 4);
        const end = endDate.substring(0, 4);

        return (
          <li class="education-item">
            <article>
              <header class="edu-header">
                <div class="edu-info">
                  <h3 class="edu-degree">{studyType} — {area}</h3>
                  <div class="edu-meta-row">
                    <span class="edu-institution">{institution}</span>
                    <span class="meta-sep">|</span>
                    <time class="edu-date">{start} — {end}</time>
                  </div>
                </div>
                {score && <span class="score-badge">{score}</span>}
              </header>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .education-item {
    padding-bottom: 1.15rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .education-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .edu-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .edu-degree {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
    letter-spacing: 0.01em;
  }

  .edu-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: #4b5563;
  }

  .edu-institution {
    font-weight: 600;
    color: #1f2937;
  }

  .meta-sep {
    color: #9ca3af;
    font-weight: 300;
  }

  .edu-date {
    color: #4b5563;
    font-size: 0.85rem;
  }

  .score-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: #111827;
    background: #f3f4f6;
    border: 1px solid #111827;
    padding: 2px 8px;
    border-radius: 3px;
    white-space: nowrap;
  }

  @media print {
    .education-item {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
      border-bottom: 1px solid #eee !important;
    }
  }
</style>

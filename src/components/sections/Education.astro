---
import type { Education } from "@/cv";
import Section from "../Section.astro"

const education = Astro.props.education as Education;
const isSpanish = education.title.toLowerCase().includes("educación");
const presentLabel = isSpanish ? "Actual" : "Present";
---

<Section title={education.title}>
  <ul>
    {
      education.items.map(({ institution, startDate, endDate, area }) => {
        const start = startDate.substring(0, 7)
        const end = endDate != null ? endDate.substring(0, 7) : presentLabel

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{institution}</h3>
                </div>

                <time>{start} - {end}</time>
              </header>

              <footer>
                <p>{area}</p>
              </footer>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }

  @media print {
    ul {
      gap: 10px;
    }
    article {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    header {
      margin-bottom: 2px;
    }
    article h3 {
      font-size: 0.9rem;
      font-weight: 700;
      color: #000;
    }
    time {
      font-size: 0.78rem;
      color: #555;
    }
    p {
      font-size: 0.78rem;
      color: #333;
    }
  }
</style>

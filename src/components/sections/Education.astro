---
import Section from "../Section.astro";
import type { PortfolioData } from "@/content";

interface Props {
  education: PortfolioData["education"];
}

const { education } = Astro.props;
---

<Section title={education.title}>
  <ul>
    {
      education.items.map(({ institution, area, studyType, startDate, endDate, score }) => {
        const start = startDate.substring(0, 4);
        const end = endDate.substring(0, 4);

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{institution}</h3>
                  <h4>{studyType} — {area}</h4>
                </div>
                <time>{start} — {end}</time>
              </header>
              {score && <p class="score">{score}</p>}
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  article h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: #111827;
    margin: 0;
  }

  article h4 {
    font-size: 0.9rem;
    font-weight: 500;
    color: #4b5563;
    margin: 2px 0 0 0;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  time {
    color: #6b7280;
    font-size: 0.85rem;
    min-width: 90px;
    text-align: right;
  }

  .score {
    font-size: 0.8rem;
    color: #0284c7;
    margin-top: 4px;
  }
</style>

---
import Section from "../Section.astro";
import type { EnrichedProject, SiteLabels, Locale } from "../../content";

interface Props {
  projects: EnrichedProject[];
  title: string;
  labels: SiteLabels;
  lang?: Locale;
}

const { projects, title, labels, lang = "en" } = Astro.props;
const isEs = lang === "es" || labels.projects === "Proyectos";

const INITIAL_PROJ_COUNT = 4;
const hiddenProjCount = projects.length - INITIAL_PROJ_COUNT;
---

<Section title={title}>
  <div class="projects-container" id="projects-container">
    <div class="projects-grid" id="projects-grid">
      {
        projects.map(({ name, url, description, highlights, technologies, confidentiality }, index) => {
          const isPrivate = confidentiality === "private_enterprise";
          const isCollapsed = index >= INITIAL_PROJ_COUNT;

          return (
            <article class={`project-card ${isCollapsed ? "proj-collapsible is-collapsed" : ""}`}>
              <header>
                <div class="project-title-row">
                  {url ? (
                    <a href={url} target="_blank" rel="noopener noreferrer" class="project-link">
                      <h3>{name}</h3>
                    </a>
                  ) : (
                    <h3>{name}</h3>
                  )}
                  {isPrivate && <span class="private-tag">{labels.privateProject}</span>}
                </div>
                <p class="project-desc">{description}</p>
              </header>

              <ul class="project-highlights">
                {highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>

              <footer>
                <div class="tech-tags">
                  {technologies.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </footer>
            </article>
          );
        })
      }
    </div>

    {
      hiddenProjCount > 0 && (
        <div class="toggle-btn-wrapper no-print">
          <button
            type="button"
            id="toggle-proj-btn"
            class="toggle-btn"
            aria-expanded="false"
            aria-controls="projects-grid"
            data-expand-text={isEs ? `+ Ver ${hiddenProjCount} proyectos más` : `+ View ${hiddenProjCount} more projects`}
            data-collapse-text={isEs ? "− Mostrar menos proyectos" : "− Show fewer projects"}
          >
            <span class="btn-text">
              {isEs ? `+ Ver ${hiddenProjCount} proyectos más` : `+ View ${hiddenProjCount} more projects`}
            </span>
          </button>
        </div>
      )
    }
  </div>
</Section>

<script is:inline>
  (function () {
    const btn = document.getElementById("toggle-proj-btn");
    const container = document.getElementById("projects-container");
    if (!btn || !container) return;

    btn.addEventListener("click", function () {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      const items = container.querySelectorAll(".proj-collapsible");
      const btnText = btn.querySelector(".btn-text");

      if (isExpanded) {
        // Collapse
        items.forEach((item) => item.classList.add("is-collapsed"));
        btn.setAttribute("aria-expanded", "false");
        if (btnText) btnText.textContent = btn.dataset.expandText || "";
        
        // Smooth scroll to container top
        container.scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        // Expand
        items.forEach((item) => item.classList.remove("is-collapsed"));
        btn.setAttribute("aria-expanded", "true");
        if (btnText) btnText.textContent = btn.dataset.collapseText || "";
      }
    });
  })();
</script>

<style>
  .projects-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    scroll-margin-top: 24px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.35rem;
  }

  .proj-collapsible.is-collapsed {
    display: none;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    background: #ffffff;
    border-radius: 4px;
    border: 1.5px solid #111827;
    padding: 1.15rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 2px 2px 0px rgba(17, 24, 39, 0.4);
  }

  .project-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #111827;
  }

  .project-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .project-title-row h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
    letter-spacing: 0.01em;
  }

  .project-link {
    color: #111827;
    text-decoration: none;
  }

  .project-link:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .private-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #111827;
    background: #f3f4f6;
    border: 1px solid #111827;
    padding: 2px 6px;
    border-radius: 3px;
  }

  .project-desc {
    color: #374151;
    font-size: 0.86rem;
    line-height: 1.45;
    margin: 0;
  }

  .project-highlights {
    list-style: none;
    padding-left: 0;
    margin: 0.4rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .project-highlights li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.82rem;
    color: #4b5563;
    line-height: 1.4;
  }

  .project-highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 3.5px;
    height: 3.5px;
    background-color: #111827;
    border-radius: 1px;
  }

  footer {
    margin-top: auto;
    padding-top: 0.65rem;
    border-top: 1px solid #e5e7eb;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .tech-tag {
    font-size: 0.74rem;
    font-weight: 500;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    color: #1f2937;
    padding: 2px 6px;
    border-radius: 3px;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .tech-tag:hover {
    background: #111827;
    color: #ffffff;
    border-color: #111827;
  }

  /* Toggle button */
  .toggle-btn-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .toggle-btn {
    appearance: none;
    background-color: #ffffff;
    color: #111827;
    border: 1.5px solid #111827;
    border-radius: 4px;
    padding: 0.65rem 1.4rem;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 2px 2px 0px rgba(17, 24, 39, 0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .toggle-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #111827;
    background-color: #111827;
    color: #ffffff;
  }

  .toggle-btn:focus-visible {
    outline: 2px solid #111827;
    outline-offset: 3px;
  }

  @media print {
    .project-card {
      border: 1px solid #000 !important;
      box-shadow: none !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }
    .proj-collapsible.is-collapsed {
      display: flex !important;
    }
    .toggle-btn-wrapper {
      display: none !important;
    }
    .tech-tag {
      border: 1px solid #ccc !important;
      background: none !important;
    }
  }
</style>

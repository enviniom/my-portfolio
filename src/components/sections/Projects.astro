---
import type { Projects } from "@/cv";
import Section from "../Section.astro";

const projects = Astro.props.projects as Projects;
---

<Section title={projects.title}>
  <ul>
    {
      projects.items.map(({ name, url, description, highlights }, index) => {
        const hasPublicUrl = url && url !== "#";
        const privateLabel = projects.title.toLowerCase().includes("proyectos")
          ? "Proyecto privado empresarial"
          : "Private enterprise project";
        const isPrintHidden = index >= 4;

        return (
          <li class={isPrintHidden ? "no-print" : ""}>
            <article>
              <header>
                {hasPublicUrl ? (
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    <h3>{name}</h3>
                  </a>
                ) : (
                  <h3>{name}</h3>
                )}
                {!hasPublicUrl && <small class="no-print">{privateLabel}</small>}
                <p>{description}</p>
              </header>
              <footer>
                {highlights.map((highlight) => (
                  <span>{highlight}</span>
                ))}
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>
<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-inline: -13px;
  }
  article {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    border-radius: 8px;
    border: 1px solid #f2f2f2;
    padding: 0.8rem;
    height: 100%;
  }
  header {
    flex: 1;
  }

  h3 {
    margin-bottom: 4px;
  }

  small {
    display: inline-block;
    margin-bottom: 6px;
    color: #666;
    font-size: 0.75rem;
    font-weight: 500;
  }

  article a {
    color: #111;
  }
  article a:hover {
    text-decoration: underline;
  }

  article p {
    font-size: 0.9rem;
    line-height: 1.2rem;
    margin-bottom: 4px;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 0.75rem;
  }

  footer span {
    border-radius: 6px;
    background-color: #eee;
    color: #444;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  @media (width <= 700px) {
    ul {
      margin-inline: 0px;
    }

    article {
      border: none;
      box-shadow: 0 1px 1px #f2f2f2;
      padding: 0 0 16px 0;
    }
  }

  @media print {
    ul {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-inline: 0;
    }
    article {
      break-inside: avoid;
      page-break-inside: avoid;
      border: 1px solid #e0e0e0;
      padding: 8px 10px;
      gap: 4px;
    }
    h3 {
      font-size: 0.88rem;
      color: #000;
      margin-bottom: 2px;
    }
    article p {
      font-size: 0.74rem;
      line-height: 1.25;
      color: #333;
      margin-bottom: 4px;
    }
    footer {
      gap: 3px;
    }
    footer span {
      font-size: 0.68rem;
      padding: 0.1rem 0.35rem;
      background-color: #f7f7f7;
      border: 1px solid #e5e5e5;
      color: #222;
    }
  }
</style>

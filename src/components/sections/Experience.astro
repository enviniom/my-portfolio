---
import type { Work } from "@/cv";
import Section from "../Section.astro";

const work = Astro.props.work as Work;
const isSpanish = work.title.toLowerCase().includes("experiencia");
const labels = {
  app: isSpanish ? "Aplicación" : "App",
  highlights: isSpanish ? "Logros" : "Highlights",
  present: isSpanish ? "Actual" : "Present",
};
---

<Section title={work.title}>
  <ul>
    {
      work.items.map(
        (
          {
            name,
            position,
            startDate,
            endDate,
            summary,
            responsibilities,
            technologies,
            highlights,
          },
          index
        ) => {
          const start = startDate.substring(0, 7);
          const end = endDate != null ? endDate.substring(0, 7) : labels.present;
          const isPrintHidden = index >= 5;
          return (
            <li class={isPrintHidden ? "no-print" : ""}>
              <article>
                <header>
                  <div>
                    <h3>{name}</h3>
                    <h4>{position}</h4>
                  </div>
                  <time>
                    {start} - {end}
                  </time>
                </header>
                <p>
                  <strong>{labels.app}:</strong>
                  {summary}
                </p>
                <p>
                  <strong>{responsibilities.name}:</strong>
                </p>
                <ul class="detail-list">
                  {responsibilities.items.slice(0, 5).map((item) => <li>{item}</li>)}
                </ul>
                <footer>
                  <p>
                    <strong>{technologies.name}:</strong>
                  </p>
                  <ul class="tech-list">
                    {
                      technologies.items.map((item) => {
                        const colonIdx = item.indexOf(":");
                        if (colonIdx !== -1) {
                          const cat = item.substring(0, colonIdx).trim();
                          const val = item.substring(colonIdx + 1).trim();
                          return (
                            <li>
                              <strong class="tech-cat">{cat}:</strong>
                              <span class="tech-val">{val}</span>
                            </li>
                          );
                        }
                        return <li>{item}</li>;
                      })
                    }
                  </ul>
                  {
                    highlights.length > 0 && (
                      <>
                        <p>
                          <strong>{labels.highlights}:</strong>
                        </p>
                        <ul class="detail-list">
                          {highlights.map((item) => <li>{item}</li>)}
                        </ul>
                      </>
                    )
                  }
                  <hr class="no-print" />
                </footer>
              </article>
            </li>
          );
        }
      )
    }
  </ul>
  <p class="print-history-note print">
    <strong>{isSpanish ? "Nota:" : "Note:"}</strong> {isSpanish ? "Para consultar la trayectoria completa y proyectos anteriores a 2024, visite el portafolio en vivo:" : "To review the complete career trajectory and projects prior to 2024, visit the live portfolio:"} <a href="https://playkru.com">https://playkru.com</a>
  </p>
</Section>
<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  article h3 {
    color: #111;
    font-weight: 500;
  }
  article h4 {
    color: #222;
    font-weight: 400;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }
  time {
    color: #555;
    font-size: 0.9rem;
    min-width: 102px;
  }
  hr {
    opacity: 0.5;
  }
  p {
    margin-bottom: 6px;
  }

  .detail-list {
    list-style: disc;
    padding-left: 1.15rem;
    margin: 0 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .detail-list li {
    color: #444;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .tech-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0 0 0.75rem;
  }

  .tech-list li {
    font-size: 0.82rem;
    line-height: 1.4;
    color: #444;
    display: block;
  }

  .tech-cat {
    font-weight: 600;
    color: #222;
    margin-right: 4px;
  }

  .tech-val {
    color: #555;
  }

  @media (width <= 768px) {
    time {
      text-align: right;
    }
  }

  @media print {
    ul {
      gap: 14px;
    }
    article {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    header {
      margin-bottom: 2px;
    }
    article h3 {
      font-size: 0.95rem;
      font-weight: 700;
      color: #000;
    }
    article h4 {
      font-size: 0.85rem;
      font-weight: 600;
      color: #333;
    }
    time {
      font-size: 0.78rem;
      color: #555;
    }
    p {
      margin-bottom: 3px;
      font-size: 0.78rem;
      line-height: 1.35;
      color: #222;
    }
    .detail-list {
      margin: 0 0 4px;
      padding-left: 1rem;
      gap: 2px;
    }
    .detail-list li {
      font-size: 0.76rem;
      line-height: 1.3;
      color: #222;
    }
    .tech-list {
      margin: 0 0 4px;
      gap: 2px;
    }
    .tech-list li {
      font-size: 0.72rem;
      line-height: 1.3;
      color: #333;
      padding: 0;
      background: transparent;
      border: none;
    }
    .tech-cat {
      font-weight: 700;
      color: #000;
    }
    .tech-val {
      color: #222;
    }
    .print-history-note {
      margin-top: 12px;
      padding-top: 6px;
      border-top: 1px dashed #ccc;
      font-size: 0.75rem;
      color: #555;
    }
    .print-history-note a {
      color: #111;
      text-decoration: underline;
    }
  }
</style>

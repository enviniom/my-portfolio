---
import Section from "../Section.astro";
import type { EnrichedExperience, SiteLabels, Locale } from "../../content";

interface Props {
  experiences: EnrichedExperience[];
  labels: SiteLabels;
  lang: Locale;
}

const { experiences, labels, lang } = Astro.props;

// Group CENS experiences
const censExperiences = experiences.filter((e) => e.clientGrouping === "cens-grupo-epm");

type TimelineItem =
  | { type: "single"; exp: EnrichedExperience }
  | { type: "cens_group"; items: EnrichedExperience[] };

const timeline: TimelineItem[] = [];
let censInserted = false;

for (const exp of experiences) {
  if (exp.clientGrouping === "cens-grupo-epm") {
    if (!censInserted) {
      timeline.push({ type: "cens_group", items: censExperiences });
      censInserted = true;
    }
  } else {
    timeline.push({ type: "single", exp });
  }
}

const censGroupTitle =
  lang === "es"
    ? "CENS Grupo EPM — Contratos recurrentes de ingeniería de software (2020, 2023, 2025, 2026)"
    : "CENS Grupo EPM — Recurring Software Engineering Engagements (2020, 2023, 2025, 2026)";

const censGroupNote =
  lang === "es"
    ? "Relación profesional recurrente para el diseño e implementación de sistemas empresariales críticos sobre .NET (C#, ASP.NET Core, SQL Server, Active Directory SSO)."
    : "Recurring software engineering engagements for the architecture and delivery of mission-critical systems on .NET (C#, ASP.NET Core, SQL Server, Active Directory SSO).";
---

<Section title={labels.experience}>
  <div class="experience-container">
    <ul class="experience-list">
      {
        timeline.map((item) => {
          if (item.type === "cens_group") {
            return (
              <li class="cens-group-wrapper">
                <div class="cens-group-header">
                  <div class="cens-title-row">
                    <h3>{censGroupTitle}</h3>
                    <span class="group-tag">{lang === "es" ? "4 Proyectos" : "4 Projects"}</span>
                  </div>
                  <p class="cens-group-note">{censGroupNote}</p>
                </div>
                <div class="cens-subcards">
                  {item.items.map((subExp) => (
                    <article class="cens-subcard">
                      <header>
                        <div>
                          <h4>{subExp.role}</h4>
                          <span class="subcard-org">{subExp.organization}</span>
                        </div>
                        <time>{subExp.startDate} — {subExp.endDate || labels.present}</time>
                      </header>
                      <p class="subcard-summary">{subExp.summary}</p>
                      <ul class="detail-list">
                        {subExp.responsibilities.map((resp) => <li>{resp}</li>)}
                      </ul>
                      <div class="tech-row">
                        <strong>{lang === "es" ? "Tecnologías" : "Tech Stack"}:</strong>
                        <span>{subExp.technologies.flatMap((t) => t.items).join(", ")}</span>
                      </div>
                    </article>
                  ))}
                </div>
              </li>
            );
          }

          const { exp } = item;
          const end = exp.endDate != null ? exp.endDate : labels.present;

          return (
            <li class="single-experience-card">
              <article>
                <header>
                  <div>
                    <h3>{exp.organization}</h3>
                    <h4>{exp.role}</h4>
                  </div>
                  <time>{exp.startDate} — {end}</time>
                </header>
                <p class="exp-summary">{exp.summary}</p>
                <ul class="detail-list">
                  {exp.responsibilities.map((resp) => <li>{resp}</li>)}
                </ul>
                <div class="tech-row">
                  <strong>{lang === "es" ? "Tecnologías" : "Tech Stack"}:</strong>
                  <span>{exp.technologies.flatMap((t) => t.items).join(", ")}</span>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</Section>

<style>
  .experience-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .single-experience-card {
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .single-experience-card article {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2px;
  }

  header h3 {
    color: #111827;
    font-size: 1.15rem;
    font-weight: 600;
  }

  header h4 {
    color: #4b5563;
    font-size: 0.95rem;
    font-weight: 500;
  }

  time {
    color: #6b7280;
    font-size: 0.85rem;
    white-space: nowrap;
    min-width: 110px;
    text-align: right;
  }

  .exp-summary {
    color: #374151;
    font-size: 0.92rem;
    line-height: 1.45;
    margin: 0;
  }

  .detail-list {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .detail-list li {
    color: #4b5563;
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .tech-row {
    font-size: 0.82rem;
    color: #4b5563;
    background: #f9fafb;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid #f3f4f6;
  }

  .tech-row strong {
    color: #1f2937;
    margin-right: 4px;
  }

  /* CENS Grouped Entity */
  .cens-group-wrapper {
    background: #fcfcfd;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.25rem;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .cens-group-header {
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
  }

  .cens-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cens-title-row h3 {
    color: #0f172a;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }

  .group-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: #0369a1;
    background: #e0f2fe;
    padding: 2px 8px;
    border-radius: 10px;
  }

  .cens-group-note {
    color: #64748b;
    font-size: 0.82rem;
    margin-top: 4px;
    line-height: 1.35;
  }

  .cens-subcards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cens-subcard {
    background: #ffffff;
    border: 1px solid #f1f5f9;
    border-radius: 8px;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .cens-subcard h4 {
    color: #1e293b;
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }

  .subcard-org {
    font-size: 0.8rem;
    color: #64748b;
  }

  .subcard-summary {
    color: #334155;
    font-size: 0.85rem;
    line-height: 1.35;
    margin: 0;
  }

  @media print {
    .experience-list {
      gap: 1.25rem;
    }
    .cens-group-wrapper {
      background: none !important;
      border: 1px solid #ddd !important;
      padding: 0.75rem !important;
    }
    .cens-subcard {
      border: 1px solid #eee !important;
      padding: 0.5rem !important;
    }
    .tech-row {
      background: none !important;
      border: 1px solid #eee !important;
      padding: 4px 6px !important;
      font-size: 0.75rem !important;
    }
    .single-experience-card,
    .cens-subcard,
    .cens-group-wrapper {
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
  }
</style>

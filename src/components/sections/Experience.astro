---
import Section from "../Section.astro";
import type { EnrichedExperience, SiteLabels, Locale } from "../../content";

interface Props {
  experiences: EnrichedExperience[];
  labels: SiteLabels;
  lang: Locale;
}

const { experiences, labels, lang } = Astro.props;

function getContractBadge(id: string, isCurrent: boolean, lang: Locale): string {
  if (id === "cens-catalog") {
    return lang === "es" ? "Contrato Recurrente · 3 Fases" : "Recurring Contract · 3 Phases";
  }
  if (isCurrent) {
    return lang === "es" ? "Tiempo Completo" : "Full-time";
  }
  return lang === "es" ? "Contrato por Proyecto" : "Project Contract";
}

// Consolidated Catálogo de Servicios experience (2020, 2023, 2025)
const catalogExperience = {
  id: "cens-catalog",
  organization: "CENS Grupo EPM",
  role:
    lang === "es"
      ? "Desarrollador Fullstack & Líder Técnico — Catálogo de Servicios"
      : "Fullstack Developer & Technical Lead — Service Catalog",
  displayDate: "2020 — 2025",
  summary:
    lang === "es"
      ? "Plataforma empresarial para la gestión y consulta del catálogo interno de servicios y productos corporativos. Recontratado en 3 ocasiones para liderar el diseño inicial y sus modernizaciones mayores de arquitectura."
      : "Enterprise intranet platform for internal service and product catalog management. Re-engaged across 3 major phases to lead initial design and major architectural modernizations.",
  phases:
    lang === "es"
      ? [
          {
            period: "2025-04 — 2025-05 (Fase 3 · Modernización)",
            desc: "Modernización a .NET 9 (ASP.NET Web API) y Angular 19; optimización transaccional en SQL Server.",
          },
          {
            period: "2023-07 — 2023-10 (Fase 2 · Refactorización)",
            desc: "Refactorización hacia servicios REST desacoplados en .NET 7 (C#) y cliente web en Angular 17.",
          },
          {
            period: "2020-11 — 2021-03 (Fase 1 · Arquitectura Inicial)",
            desc: "Definición arquitectónica, modelado y normalización de base de datos relacional y puesta en producción en IIS.",
          },
        ]
      : [
          {
            period: "2025-04 — 2025-05 (Phase 3 · Modernization)",
            desc: "Modernized enterprise platform to .NET 9 (ASP.NET Web API) and Angular 19; SQL Server transactional optimization.",
          },
          {
            period: "2023-07 — 2023-10 (Phase 2 · Refactoring)",
            desc: "Refactored architecture to decoupled REST services on .NET 7 (C#) and Angular 17 web frontend.",
          },
          {
            period: "2020-11 — 2021-03 (Phase 1 · Initial Architecture)",
            desc: "Architectural definition, relational database modeling, and initial production deployment on IIS / Windows Server.",
          },
        ],
  technologies: [
    "C#",
    ".NET 9",
    ".NET 7",
    "ASP.NET Web API",
    "Angular 19",
    "Angular 17",
    "SQL Server",
    "Entity Framework Core",
    "IIS",
    "JavaScript",
  ],
};

// Build linear timeline items
interface ProcessedExperience {
  id: string;
  role: string;
  organization: string;
  displayDate: string;
  summary: string;
  badge: string;
  isCatalog: boolean;
  phases?: Array<{ period: string; desc: string }>;
  responsibilities?: string[];
  technologies: string[];
}

const timelineItems: ProcessedExperience[] = [];

for (const exp of experiences) {
  if (exp.id === "cens-catalog-2025") {
    timelineItems.push({
      id: catalogExperience.id,
      role: catalogExperience.role,
      organization: catalogExperience.organization,
      displayDate: catalogExperience.displayDate,
      summary: catalogExperience.summary,
      badge: getContractBadge(catalogExperience.id, false, lang),
      isCatalog: true,
      phases: catalogExperience.phases,
      technologies: catalogExperience.technologies,
    });
  } else if (exp.id === "cens-catalog-2023" || exp.id === "cens-catalog-2020") {
    // Consolidated above
    continue;
  } else {
    const end = exp.endDate != null ? exp.endDate : labels.present;
    const roleTitle =
      exp.id === "cens-sicont"
        ? (lang === "es" ? "Desarrollador Fullstack — SICont" : "Fullstack Developer — SICont")
        : exp.role;
    timelineItems.push({
      id: exp.id,
      role: roleTitle,
      organization: exp.organization,
      displayDate: `${exp.startDate} — ${end}`,
      summary: exp.summary,
      badge: getContractBadge(exp.id, exp.isCurrent, lang),
      isCatalog: false,
      responsibilities: exp.responsibilities,
      technologies: exp.technologies.flatMap((t) => t.items),
    });
  }
}

const INITIAL_EXP_COUNT = 3;
const hiddenExpCount = timelineItems.length - INITIAL_EXP_COUNT;
---

<Section title={labels.experience}>
  <div class="experience-container" id="experience-container">
    <ul class="experience-list" id="experience-list">
      {
        timelineItems.map((item, index) => {
          const isCollapsed = index >= INITIAL_EXP_COUNT;

          if (item.isCatalog) {
            return (
              <li class={`experience-item ${isCollapsed ? "exp-collapsible is-collapsed" : ""}`}>
                <article class="experience-card">
                  <header class="exp-header">
                    <div class="exp-header-main">
                      <div class="exp-title-row">
                        <h3 class="exp-role">{item.role}</h3>
                        <span class="contract-badge">{item.badge}</span>
                      </div>
                      <div class="exp-meta-row">
                        <span class="exp-org">{item.organization}</span>
                        <span class="meta-sep">|</span>
                        <time class="exp-date">{item.displayDate}</time>
                      </div>
                    </div>
                  </header>

                  <p class="exp-summary">{item.summary}</p>

                  {item.phases && (
                    <div class="phases-container">
                      <h5 class="phases-title">
                        {lang === "es" ? "Hitos de evolución y modernización:" : "Evolution & modernization milestones:"}
                      </h5>
                      <ul class="phases-list">
                        {item.phases.map((phase) => (
                          <li class="phase-item">
                            <span class="phase-period">{phase.period}:</span>
                            <span class="phase-desc">{phase.desc}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <footer class="exp-footer">
                    <div class="tech-row">
                      <strong>{lang === "es" ? "Tecnologías" : "Tech Stack"}:</strong>
                      <span>{item.technologies.join(", ")}</span>
                    </div>
                  </footer>
                </article>
              </li>
            );
          }

          return (
            <li class={`experience-item ${isCollapsed ? "exp-collapsible is-collapsed" : ""}`}>
              <article class="experience-card">
                <header class="exp-header">
                  <div class="exp-header-main">
                    <div class="exp-title-row">
                      <h3 class="exp-role">{item.role}</h3>
                      <span class="contract-badge">{item.badge}</span>
                    </div>
                    <div class="exp-meta-row">
                      <span class="exp-org">{item.organization}</span>
                      <span class="meta-sep">|</span>
                      <time class="exp-date">{item.displayDate}</time>
                    </div>
                  </div>
                </header>

                <p class="exp-summary">{item.summary}</p>

                {item.responsibilities && (
                  <ul class="detail-list">
                    {item.responsibilities.map((resp, respIdx) => {
                      const isRespCollapsed = respIdx >= 3;
                      return (
                        <li class={isRespCollapsed ? "resp-collapsible is-collapsed" : ""}>
                          {resp}
                        </li>
                      );
                    })}
                  </ul>
                )}

                {item.responsibilities && item.responsibilities.length > 3 && (
                  <div class="resp-toggle-wrapper no-print">
                    <button
                      type="button"
                      class="resp-toggle-btn"
                      aria-expanded="false"
                      data-expand-text={
                        lang === "es"
                          ? `+ ${item.responsibilities.length - 3} detalles más`
                          : `+ ${item.responsibilities.length - 3} more details`
                      }
                      data-collapse-text={
                        lang === "es" ? "− Menos detalles" : "− Fewer details"
                      }
                    >
                      <span class="resp-btn-text">
                        {lang === "es"
                          ? `+ ${item.responsibilities.length - 3} detalles más`
                          : `+ ${item.responsibilities.length - 3} more details`}
                      </span>
                    </button>
                  </div>
                )}

                <footer class="exp-footer">
                  <div class="tech-row">
                    <strong>{lang === "es" ? "Tecnologías" : "Tech Stack"}:</strong>
                    <span>{item.technologies.join(", ")}</span>
                  </div>
                </footer>
              </article>
            </li>
          );
        })
      }
    </ul>

    {
      hiddenExpCount > 0 && (
        <div class="toggle-btn-wrapper no-print">
          <button
            type="button"
            id="toggle-exp-btn"
            class="toggle-btn"
            aria-expanded="false"
            aria-controls="experience-list"
            data-expand-text={lang === "es" ? `+ Ver ${hiddenExpCount} experiencias anteriores` : `+ View ${hiddenExpCount} more experiences`}
            data-collapse-text={lang === "es" ? "− Mostrar menos experiencias" : "− Show fewer experiences"}
          >
            <span class="btn-text">
              {lang === "es" ? `+ Ver ${hiddenExpCount} experiencias anteriores` : `+ View ${hiddenExpCount} more experiences`}
            </span>
          </button>
        </div>
      )
    }
  </div>
</Section>

<script is:inline>
  (function () {
    const btn = document.getElementById("toggle-exp-btn");
    const container = document.getElementById("experience-container");
    if (!container) return;

    // 1. Toggle entire list of experiences (expand beyond top 3)
    if (btn) {
      btn.addEventListener("click", function () {
        const isExpanded = btn.getAttribute("aria-expanded") === "true";
        const items = container.querySelectorAll(".exp-collapsible");
        const btnText = btn.querySelector(".btn-text");

        if (isExpanded) {
          items.forEach((item) => item.classList.add("is-collapsed"));
          btn.setAttribute("aria-expanded", "false");
          if (btnText) btnText.textContent = btn.dataset.expandText || "";
          container.scrollIntoView({ behavior: "smooth", block: "start" });
        } else {
          items.forEach((item) => item.classList.remove("is-collapsed"));
          btn.setAttribute("aria-expanded", "true");
          if (btnText) btnText.textContent = btn.dataset.collapseText || "";
        }
      });
    }

    // 2. Toggle responsibilities inside individual experience cards
    container.addEventListener("click", function (e) {
      const toggleRespBtn = e.target.closest(".resp-toggle-btn");
      if (!toggleRespBtn) return;

      const card = toggleRespBtn.closest(".experience-card");
      if (!card) return;

      const isExpanded = toggleRespBtn.getAttribute("aria-expanded") === "true";
      const collapsedBullets = card.querySelectorAll(".resp-collapsible");
      const btnText = toggleRespBtn.querySelector(".resp-btn-text");

      if (isExpanded) {
        collapsedBullets.forEach((li) => li.classList.add("is-collapsed"));
        toggleRespBtn.setAttribute("aria-expanded", "false");
        if (btnText) btnText.textContent = toggleRespBtn.dataset.expandText || "";
      } else {
        collapsedBullets.forEach((li) => li.classList.remove("is-collapsed"));
        toggleRespBtn.setAttribute("aria-expanded", "true");
        if (btnText) btnText.textContent = toggleRespBtn.dataset.collapseText || "";
      }
    });
  })();
</script>

<style>
  .experience-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    scroll-margin-top: 24px;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .experience-item {
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .exp-collapsible.is-collapsed {
    display: none;
  }

  .experience-card {
    background: #ffffff;
    border: 1.5px solid #111827;
    border-radius: 4px;
    padding: 1.25rem;
    box-shadow: 2px 2px 0px rgba(17, 24, 39, 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .experience-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #111827;
  }

  .exp-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .exp-header-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .exp-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .exp-role {
    color: #111827;
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .contract-badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #111827;
    background: #f3f4f6;
    border: 1px solid #111827;
    padding: 2px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .exp-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: #4b5563;
    flex-wrap: wrap;
  }

  .exp-org {
    font-weight: 600;
    color: #1f2937;
  }

  .meta-sep {
    color: #9ca3af;
    font-weight: 300;
  }

  .exp-date {
    color: #4b5563;
    font-size: 0.85rem;
  }

  .exp-summary {
    color: #374151;
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0;
  }

  .detail-list {
    list-style: none;
    padding-left: 0;
    margin: 0.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .detail-list li {
    position: relative;
    padding-left: 1.1rem;
    color: #4b5563;
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .detail-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    background-color: #111827;
    border-radius: 1px;
  }

  .resp-collapsible.is-collapsed {
    display: none;
  }

  .resp-toggle-wrapper {
    margin: 0.15rem 0 0.35rem 0;
  }

  .resp-toggle-btn {
    appearance: none;
    background: none;
    border: none;
    padding: 2px 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #4b5563;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
  }

  .resp-toggle-btn:hover {
    color: #111827;
  }

  .resp-toggle-btn:focus-visible {
    outline: 2px solid #111827;
    outline-offset: 2px;
  }

  /* Phases Box for Consolidated Catalog */
  .phases-container {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 0.85rem 1rem;
    margin: 0.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .phases-title {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #111827;
    margin: 0 0 2px 0;
  }

  .phases-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .phase-item {
    position: relative;
    padding-left: 1rem;
    font-size: 0.84rem;
    line-height: 1.4;
    color: #374151;
  }

  .phase-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 4px;
    height: 4px;
    background-color: #111827;
    border-radius: 1px;
  }

  .phase-period {
    font-weight: 700;
    color: #111827;
    margin-right: 4px;
  }

  .phase-desc {
    color: #4b5563;
  }

  .exp-footer {
    margin-top: 0.25rem;
  }

  .tech-row {
    font-size: 0.82rem;
    color: #374151;
    background: #f9fafb;
    padding: 6px 10px;
    border-radius: 4px;
    border: 1px solid #e5e7eb;
  }

  .tech-row strong {
    color: #111827;
    margin-right: 4px;
  }

  /* Toggle button */
  .toggle-btn-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .toggle-btn {
    appearance: none;
    background-color: #ffffff;
    color: #111827;
    border: 1.5px solid #111827;
    border-radius: 4px;
    padding: 0.65rem 1.4rem;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 2px 2px 0px rgba(17, 24, 39, 0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .toggle-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #111827;
    background-color: #111827;
    color: #ffffff;
  }

  .toggle-btn:focus-visible {
    outline: 2px solid #111827;
    outline-offset: 3px;
  }

  @media print {
    .experience-list {
      gap: 1.25rem;
    }
    .experience-card {
      border: 1px solid #000 !important;
      box-shadow: none !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
      padding: 0.75rem !important;
    }
    .exp-collapsible.is-collapsed {
      display: block !important;
    }
    .resp-collapsible.is-collapsed {
      display: list-item !important;
    }
    .toggle-btn-wrapper,
    .resp-toggle-wrapper {
      display: none !important;
    }
    .tech-row,
    .phases-container {
      background: none !important;
      border: 1px solid #ddd !important;
      padding: 4px 6px !important;
    }
    .contract-badge {
      border: 1px solid #000 !important;
      background: none !important;
    }
  }
</style>

---
import Section from "../Section.astro";
const { summary, title, highlights = [] } = Astro.props;
---

<Section title={title}>
	<p>{summary}</p>
	{
		highlights.length > 0 && (
			<ul>
				{highlights.map((item: string) => <li>{item}</li>)}
			</ul>
		)
	}
</Section>

<style>
	p {
		margin-bottom: 1.25rem;
		color: #1f2937;
		font-size: 0.95rem;
		line-height: 1.65;
		text-wrap: pretty;
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding-left: 1.25rem;
		margin: 0;
		list-style: none;
	}

	li {
		position: relative;
		color: #374151;
		font-size: 0.88rem;
		line-height: 1.5;
		padding-left: 1rem;
	}

	li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 4px;
		height: 4px;
		background-color: #111827;
		border-radius: 1px;
	}
</style>

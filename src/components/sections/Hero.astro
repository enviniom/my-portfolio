---
import Section from "../Section.astro";
import WorldMap from "../icons/WorldMap.astro";
import type { PortfolioData } from "../../content";

interface Props {
  basics: PortfolioData["basics"];
}

const { basics } = Astro.props;
const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;

// Split name for high-contrast typographic contrast (light first name + bold last name)
const nameParts = name.trim().split(/\s+/);
const firstName = nameParts[0] || "JHON";
const lastName = nameParts.slice(1).join(" ") || "COLMENARES";

const linkedInProfile = profiles.find((p) => p.network === "LinkedIn");
const gitHubProfile = profiles.find((p) => p.network === "GitHub");

const printLocation = [city, region].filter(Boolean).join(", ");
const printItems = [
  email,
  phone,
  printLocation,
  linkedInProfile ? "linkedin.com/in/enviniom" : null,
  gitHubProfile ? "github.com/enviniom" : null,
  "enviniom.github.io/my-portfolio",
].filter(Boolean);
---

<Section>
  <div class="hero-card">
    <div class="hero-main">
      <!-- Left Content: Editorial Identity & Summary -->
      <div class="hero-content">
        <header class="hero-identity">
          <h1 class="hero-name">
            <span class="name-first">{firstName}</span>{" "}
            <span class="name-last">{lastName}</span>
          </h1>
          <div class="hero-divider" aria-hidden="true"></div>
          <p class="hero-role">{label}</p>
        </header>

        <div class="hero-meta no-print">
          <span class="meta-item location">
            <WorldMap />
            <span>{city}, {region}</span>
          </span>
          <span class="meta-sep" aria-hidden="true">•</span>
          <span class="meta-item status">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Remote / Hybrid</span>
          </span>
        </div>

        <!-- Print-only Contact Info -->
        <div class="print contact-print">
          {printItems.map((item, idx) => (
            <span>
              {item}
              {idx < printItems.length - 1 && <span class="sep">•</span>}
            </span>
          ))}
        </div>
      </div>

      <!-- Right Column: Editorial Framed Portrait -->
      <figure class="hero-portrait no-print">
        <div class="portrait-frame">
          <img
            src={image}
            alt={name}
            width="150"
            height="150"
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </div>
</Section>

<style>
  /* ----------------------------------------------------
     EDITORIAL HERO SECTION
     ---------------------------------------------------- */
  .hero-card {
    width: 100%;
    margin-bottom: 10px;
  }

  .hero-main {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.2rem;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .hero-identity {
    display: flex;
    flex-direction: column;
  }

  /* Typographic Contrast (Matches PDF Header) */
  .hero-name {
    margin: 0;
    line-height: 1.05;
    text-transform: uppercase;
    color: #111827;
  }

  .name-first {
    font-size: clamp(2rem, 4.2vw, 2.65rem);
    font-weight: 300;
    letter-spacing: 0.08em;
  }

  .name-last {
    font-size: clamp(2rem, 4.2vw, 2.65rem);
    font-weight: 900;
    letter-spacing: 0.02em;
  }

  /* Crisp Editorial Divider */
  .hero-divider {
    height: 2px;
    width: 100%;
    background-color: #111827;
    margin: 0.55rem 0 0.65rem 0;
  }

  .hero-role {
    font-size: 1.05rem;
    font-weight: 600;
    color: #1f2937;
    line-height: 1.38;
    margin: 0;
    text-wrap: balance;
  }

  /* Metadata Badges */
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: #4b5563;
    margin-top: 2px;
    flex-wrap: wrap;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .meta-sep {
    color: #9ca3af;
    user-select: none;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
  }

  /* Executive Brief Summary */
  .hero-summary {
    font-size: 0.94rem;
    line-height: 1.55;
    color: #374151;
    margin: 0.4rem 0 0 0;
    text-wrap: pretty;
  }

  /* Editorial Framed Portrait */
  .hero-portrait {
    flex-shrink: 0;
    margin: 4px 0 0 0;
  }

  .portrait-frame {
    position: relative;
    width: 150px;
    height: 150px;
    border: 2px solid #111827;
    border-radius: 6px;
    background-color: #ffffff;
    box-shadow: 5px 5px 0px #111827;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .portrait-frame:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0px #111827;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%) contrast(104%);
    transition: filter 0.3s ease;
  }

  .portrait-frame:hover img {
    filter: grayscale(0%);
  }

  /* Mobile Responsive (< 768px) */
  @media (max-width: 768px) {
    .hero-main {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .hero-portrait {
      margin-top: 0;
    }

    .portrait-frame {
      width: 120px;
      height: 120px;
      box-shadow: 4px 4px 0px #111827;
    }

    .hero-role {
      font-size: 0.98rem;
    }

    .hero-summary {
      font-size: 0.9rem;
      line-height: 1.5;
    }
  }

  /* Print Styles */
  @media print {
    .no-print {
      display: none !important;
    }

    .hero-card {
      margin-bottom: 12px;
    }

    .hero-name {
      color: #000000;
    }

    .name-first,
    .name-last {
      font-size: 22pt;
    }

    .hero-divider {
      background-color: #000000;
      height: 1.5px;
      margin: 4pt 0 6pt 0;
    }

    .hero-role {
      font-size: 10.5pt;
      color: #000000;
    }

    .hero-summary {
      font-size: 9.2pt;
      color: #000000;
      margin-top: 4pt;
    }

    .contact-print {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      font-size: 8.5pt;
      color: #000000;
      margin-top: 6pt;
    }

    .sep {
      margin-left: 6px;
    }
  }
</style>

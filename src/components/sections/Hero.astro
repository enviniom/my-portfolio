---
import Section from "../Section.astro";
import Mail from "../icons/Mail.astro";
import Phone from "../icons/Phone.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
import X from "../icons/X.astro";
import WorldMap from "../icons/WorldMap.astro";
import type { PortfolioData } from "../../content";

interface Props {
  basics: PortfolioData["basics"];
}

const { basics } = Astro.props;
const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn,
  X,
};

const linkedInProfile = profiles.find((p) => p.network === "LinkedIn");
const gitHubProfile = profiles.find((p) => p.network === "GitHub");

const printLocation = [city, region].filter(Boolean).join(", ");
const printItems = [
  email,
  phone,
  printLocation,
  linkedInProfile ? "linkedin.com/in/enviniom" : null,
  gitHubProfile ? "github.com/enviniom" : null,
  "enviniom.github.io/my-portfolio",
].filter(Boolean);
---

<Section>
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <h2>{label}</h2>
      <span class="location no-print">
        <WorldMap />
        {city}, {region}
      </span>
      <footer>
        <div class="print contact-print">
          {printItems.map((item, idx) => (
            <span>
              {item}
              {idx < printItems.length - 1 && <span class="sep">•</span>}
            </span>
          ))}
        </div>
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Email: ${email}`}
              aria-label={`Email: ${email}`}
              rel="noopener noreferrer"
              target="_blank"
              class="no-print"
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={`Tel: ${phone}`}
              aria-label={`Tel: ${phone}`}
              rel="noopener noreferrer"
              target="_blank"
              class="no-print"
            >
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];
            if (!Icon) return null;
            return (
              <a
                href={url}
                title={`Perfil en ${network}`}
                aria-label={`Perfil en ${network}`}
                rel="noopener noreferrer"
                target="_blank"
                class="no-print"
              >
                <Icon />
              </a>
            );
          })
        }
      </footer>
    </div>
    <figure class="no-print">
      <img src={image} alt={name} />
    </figure>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  h1 {
    font-size: 2rem;
    color: #111;
  }
  h2 {
    color: #444;
    font-weight: 500;
    font-size: 1.1rem;
    text-wrap: balance;
  }
  img {
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 10px;
    width: 150px;
    border: 1px solid #e5e7eb;
  }
  span.location {
    color: #666;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: -0.05rem;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 16px;
  }
  footer {
    display: flex;
    gap: 10px;
    margin-top: 5px;
  }
  footer a {
    color: #777;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #eee;
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }
  footer a:hover {
    background-color: #f3f4f6;
    color: #111;
    border-color: #ccc;
  }

  @media (max-width: 768px) {
    .container {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
    .info {
      padding-right: 0;
    }
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .contact-print {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      font-size: 0.8rem;
      color: #333;
    }
    .sep {
      margin-left: 6px;
    }
  }
</style>

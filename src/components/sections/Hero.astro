---
import Section from "../Section.astro";
import Mail from "../icons/Mail.astro";
import Phone from "../icons/Phone.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
import X from "../icons/X.astro";
import WorldMap from "../icons/WorldMap.astro";
import type { Basics } from "@/cv";

const { basics } = Astro.props;
const { name, label, image, location, profiles, phone, email } =
  basics as Basics;
const { city, region } = location;
const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn,
  X,
};
const linkeInUrl = profiles.find(
  (profile) => profile.network === "LinkedIn"
)?.url;
const gitHubUrl = profiles.find(
  (profile) => profile.network === "GitHub"
)?.url;
const printLocation = [city, region].filter(Boolean).join(", ");
const printItems = [
  email,
  phone,
  printLocation,
  linkeInUrl ? "linkedin.com/in/enviniom" : null,
  gitHubUrl ? "github.com/enviniom" : null,
  basics.url ? "playkru.com" : null,
].filter(Boolean);
---

<Section>
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <h2>{label}</h2>
      <span class="location no-print">
        <WorldMap />
        {city}, {region}
      </span>
      <footer>
        <div class="print contact-print">
          {printItems.map((item, idx) => (
            <span>
              {item}
              {idx < printItems.length - 1 && <span class="sep">•</span>}
            </span>
          ))}
        </div>
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Enviar correo electrónico a ${name} al buzón ${email}`}
              aria-label={`Enviar correo electrónico a ${name} al buzón ${email}`}
              rel="noopener noreferrer"
              target="_blank"
              class="no-print"
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={`Llamar por teléfono a ${name} al número ${phone}`}
              aria-label={`Llamar por teléfono a ${name} al número ${phone}`}
              rel="noopener noreferrer"
              target="_blank"
              class="no-print"
            >
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];
            return (
              <a
                href={url}
                title={`Ir al perfil de ${name} en ${network}`}
                aria-label={`Ir al perfil de ${name} en ${network}`}
                rel="noopener noreferrer"
                target="_blank"
                class="no-print"
              >
                <Icon />
              </a>
            );
          })
        }
      </footer>
    </div>
    <figure class="no-print">
      <img src={image} alt={name} />
    </figure>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  h1 {
    font-size: 2rem;
  }
  h2 {
    color: #444;
    font-weight: 500;
    font-size: 1.1rem;
    text-wrap: balance;
  }
  img {
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 10px;
    width: 150px;
  }
  span {
    color: #666;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: -0.05rem;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 32px;
  }
  footer {
    display: flex;
    gap: 10px;
    margin-top: 5px;
  }
  footer a {
    color: #777;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #eee;
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }
  footer a:hover {
    border: 1px solid #ccc;
    background-color: #eee;
  }

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
    }

    .info {
      justify-content: center;
      align-items: center;
      padding-right: 0;
      text-align: center;
    }

    figure {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    h2 {
      text-wrap: balance;
    }

    figure {
      margin: 0 auto;
    }
  }

  @media print {
    .container {
      gap: 0;
    }
    .info {
      padding-right: 0;
      gap: 0.25rem;
    }
    h1 {
      font-size: 1.6rem;
      letter-spacing: -0.02rem;
      color: #000;
    }
    h2 {
      font-size: 0.95rem;
      color: #222;
      font-weight: 600;
    }
    .contact-print {
      display: flex !important;
      flex-wrap: wrap;
      gap: 4px 6px;
      font-size: 0.78rem;
      color: #333;
      margin-top: 4px;
    }
    .contact-print .sep {
      margin-left: 6px;
      color: #888;
    }
  }
</style>

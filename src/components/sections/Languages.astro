---
import Section from "../Section.astro";
import type { PortfolioData } from "@/content";

interface Props {
  languages: PortfolioData["languages"];
}

const { languages } = Astro.props;
---

<Section title={languages.title}>
  <ul>
    {
      languages.items.map(({ language, fluency }) => (
        <li>
          <span>{language}</span>
          <small>{fluency}</small>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    gap: 10px;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    border-radius: 4px;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    color: #111827;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 1.5px 1.5px 0px rgba(17, 24, 39, 0.2);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  li:hover {
    border-color: #111827;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #111827;
  }

  small {
    color: #4b5563;
    background: #f3f4f6;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 2px;
  }

  @media print {
    ul {
      gap: 6px;
    }
    li {
      background: none !important;
      border: 1px solid #aaa !important;
      font-size: 0.72rem !important;
      padding: 0.15rem 0.45rem !important;
      box-shadow: none !important;
    }
    small {
      background: none !important;
      color: #333 !important;
    }
  }
</style>

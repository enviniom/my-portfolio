---
import Section from "../Section.astro";
import type { PortfolioData } from "@/content";

interface Props {
  languages: PortfolioData["languages"];
}

const { languages } = Astro.props;
---

<Section title={languages.title}>
  <ul>
    {
      languages.items.map(({ language, fluency }) => (
        <li>
          <span>{language}</span>
          <small>{fluency}</small>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    border-radius: 6px;
    background-color: #eee;
    color: black;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  small {
    color: #555;
    font-size: 0.72rem;
    font-weight: 600;
  }

  @media print {
    ul {
      gap: 6px;
    }
    li {
      background-color: #f7f7f7;
      border: 1px solid #e0e0e0;
      font-size: 0.72rem;
      padding: 0.15rem 0.45rem;
      color: #111;
    }
    small {
      color: #555;
      font-size: 0.65rem;
    }
  }
</style>

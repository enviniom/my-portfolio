---
const { title } = Astro.props;
---

<section>
  {title && <h2>{title}</h2>}
  <slot />
</section>

<style>
  section {
    max-width: 700px;
    margin: 0 auto 50px;
  }

  h2 {
    margin-bottom: 8px;
    font-weight: 700;
    line-height: 1.5;
    font-size: 1.5rem;
  }

  @media (width <= 700px) {
    section {
      margin-bottom: 38px;
    }
  }

  @media print {
    section {
      margin-bottom: 22px;
      max-width: 100%;
    }

    h2 {
      font-size: 1.15rem;
      margin-bottom: 6px;
      padding-bottom: 2px;
      border-bottom: 1px solid #ddd;
      letter-spacing: -0.01rem;
    }
  }
</style>

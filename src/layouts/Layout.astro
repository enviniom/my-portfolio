---
interface Props {
  title: string;
  summary?: string;
  image?: string;
  lang?: string;
  canonicalUrl?: string;
}

const {
  title,
  summary = 'Senior Backend / Fullstack Developer with 8+ years of experience in distributed systems and software architecture.',
  image = '/my-portfolio/cv1.jpg',
  lang = 'en',
  canonicalUrl = 'https://enviniom.github.io/my-portfolio/',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/my-portfolio/logo.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" as="image" href={image} />

    <!-- Open Graph / Social Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content={image} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={image} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  html {
    font-family:
      "Roboto",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Oxygen,
      Ubuntu,
      Cantarell,
      sans-serif;
    background: #fff;
    letter-spacing: -0.025rem;
  }
  body,
  figure {
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0;
    font-family: inherit;
  }
  p {
    color: #444;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  @page {
    size: letter;
    margin: 10mm 14mm;
  }

  @media print {
    html {
      font-size: 13px;
      background: #fff;
      color: #111;
    }

    body {
      color: #111;
      background: #fff;
    }

    p {
      color: #222;
      line-height: 1.38;
    }

    .print {
      display: block !important;
    }

    .no-print {
      display: none !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    section {
      break-inside: auto;
    }

    h1, h2, h3, h4 {
      break-after: avoid;
      page-break-after: avoid;
      color: #000;
    }
  }
</style>
